---
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const portfolioEntries = await getCollection('portfolio');
  
  return portfolioEntries.map(entry => {
    // 1. Strip the trailing "/index" from the ID to create a clean URL slug
    const cleanSlug = entry.id.replace(/\/index$/, '');
    
    return {
      params: { slug: cleanSlug },
      props: { entry, cleanSlug },
    };
  });
}

const { entry, cleanSlug } = Astro.props;
const { title, category, techStack, coverImage, videoUrl } = entry.data;

// 2. Fetch all MDX files
const mdxFiles = import.meta.glob('../../content/portfolio/*/content.mdx');

// 3. Construct the MDX path using our cleaned up slug (the folder name)
const mdxPath = `../../content/portfolio/${cleanSlug}/content.mdx`;

let Content = null;
if (mdxFiles[mdxPath]) {
  const mdxModule: any = await mdxFiles[mdxPath]();
  Content = mdxModule.default;
}

// 4. Helper function to ensure video URLs are embeddable
function getEmbedUrl(url: string | undefined | null) {
  if (!url) return null;

  // Catch if you accidentally pasted the full HTML embed code instead of a link
  if (url.includes('<iframe')) {
    const srcMatch = url.match(/src="([^"]+)"/);
    if (srcMatch) return srcMatch[1];
  }

  // YouTube
  if (url.includes('youtube.com/watch?v=')) {
    return url.replace('watch?v=', 'embed/').split('&')[0];
  }
  if (url.includes('youtu.be/')) {
    return url.replace('youtu.be/', 'youtube.com/embed/');
  }

  // Vimeo (Handles standard, unlisted hashes, and "manage" links)
  if (url.includes('vimeo.com')) {
    // If it's somehow already a perfect player link, just return it
    if (url.includes('player.vimeo.com')) return url; 
    
    // Extract the Video ID and the optional Privacy Hash using regex
    const match = url.match(/vimeo\.com\/(?:manage\/videos\/)?(\d+)(?:\/([a-zA-Z0-9]+))?/);
    if (match) {
      const videoId = match[1];
      const hash = match[2];
      return `https://player.vimeo.com/video/${videoId}${hash ? `?h=${hash}` : ''}`;
    }
  }

  return url;
}

const embedUrl = getEmbedUrl(videoUrl);
---

<BaseLayout 
  title={title}
  image={typeof coverImage === 'string' ? coverImage : coverImage?.src}
>
  <article class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8 relative z-10">
    <header class="mb-8">
      <h1 class="text-4xl md:text-5xl font-bold text-primary mb-4">{title}</h1>
      <p class="text-accent/80 uppercase tracking-widest text-sm font-mono mb-6">{category}</p>
      
      <div class="flex flex-wrap gap-2 mb-8">
        {techStack.map((tech) => (
          <span class="font-mono text-xs text-accent bg-accent/5 border border-accent/20 px-3 py-1.5 rounded-md tracking-wide">
            {tech}
          </span>
        ))}
      </div>
    </header>

    {/* Render Video if it exists */}
    {embedUrl && (
      <div class="mb-12 aspect-video w-full rounded-2xl overflow-hidden border border-white/5 bg-surface shadow-2xl">
        <iframe 
          src={embedUrl} 
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>
    )}

    {/* Render Cover Image: Visible if no video, hidden if video exists */}
    {coverImage && (
      <div class={`mb-12 rounded-xl overflow-hidden border border-white/5 bg-surface shadow-2xl ${embedUrl ? 'hidden' : ''}`}>
        {typeof coverImage === 'string' ? (
          <img src={coverImage} alt={title} class="w-full h-auto object-cover" />
        ) : (
          <Image src={coverImage} alt={title} width={1200} height={800} class="w-full h-auto object-cover" />
        )}
      </div>
    )}

    {/* Render the MDX Content Component */}
    {Content && (
      <div class="prose prose-invert max-w-none mb-12 text-primary/80 prose-a:text-accent hover:prose-a:text-white prose-img:rounded-xl">
        <Content />
      </div>
    )}
    
  </article>
</BaseLayout>