---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const portfolioEntries = await getCollection('portfolio');
const experienceEntries = await getCollection('experience');
console.log('Experience entries:', experienceEntries.length);

// Sort experience by date (assuming entries are added in chronological order or we can sort by id if needed)
// For now we just show them in the order they come from the filesystem.
---

<BaseLayout title="sscxyz">
  <!-- Hero Section -->
  <section class="relative px-6 pt-6 pb-16 max-w-7xl mx-auto overflow-hidden">
    <!-- ... (hero code) ... -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: linear-gradient(#bd08cdd2 1px, transparent 1px), linear-gradient(90deg, #bd08cdd2 1px, transparent 1px); background-size: 4rem 4rem;"></div>
    <!-- Glow blob -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-5xl">
      <h1 class="text-6xl md:text-7xl font-bold text-primary leading-tight tracking-tight mb-6">
        Engineering <span class="text-accent">rhythm-driven</span> visual systems and <span class="text-accent">interactive</span> installations.
      </h1>
      <p class="text-lg text-secondary leading-relaxed max-w-3xl mb-10">
        I merge code, motion design, and real-time rendering using <span class="text-primary font-medium">TouchDesigner</span> and <span class="text-primary font-medium">After Effects</span> to build scalable visual campaigns for luxury nightlife and immersive live events.
      </p>
      <div class="flex items-center gap-4">
        <a href="#portfolio" class="inline-flex items-center gap-2 bg-surface border border-white/10 text-primary font-semibold px-6 py-3 rounded-lg text-sm hover:bg-accent hover:text-white hover:border-accent active:scale-95 transition-all duration-200 group">
          View Portfolio
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 group-hover:translate-x-1 transition-transform"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </a>
        <a href="#contact" class="inline-flex items-center text-sm text-secondary hover:text-primary gap-2 transition-colors duration-200">
          Get in touch
        </a>
      </div>
    </div>

    <!-- Floating tech tags -->
    <div class="absolute right-6 top-28 hidden lg:flex flex-col gap-3">
      {['TouchDesigner', 'After Effects', 'GLSL', 'Cinema 4D', 'Premiere Pro'].map(tag => (
        <span class="font-mono text-xs text-accent border border-accent/10 bg-accent/5 px-3 py-1.5 rounded-md">
          {tag}
        </span>
      ))}
    </div>
  </section>

  <!-- Showreel Section -->
  <section class="px-6 pb-24 max-w-7xl mx-auto">
    <div class="relative w-full rounded-2xl overflow-hidden border border-white/10 bg-surface aspect-video group">
      <!-- Overlay: Now with pointer-events-none and transition -->
      <div 
        id="showreel-overlay"
        class="absolute inset-0 flex items-center justify-center bg-black/40 z-10 pointer-events-none transition-opacity duration-500"
      >
         <span class="font-mono text-sm text-white/60 uppercase tracking-widest">Showreel 2024 (60s)</span>
      </div>
      
      <iframe 
        id="showreel-iframe"
        src="https://player.vimeo.com/video/1173700788?h=13ced822f2&badge=0&autopause=0&player_id=0&app_id=58479&autoplay=1&loop=1&color=bd08cd" 
        class="absolute inset-0 w-full h-full"
        frameborder="0" 
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" 
        title="Planet Music"
      ></iframe>
    </div>
  </section>

  <!-- Load the Vimeo SDK -->
  <script src="https://player.vimeo.com/api/player.js"></script>

  <script is:inline>
    // Wait for SDK and page load
    window.addEventListener('load', () => {
      const iframe = document.querySelector('#showreel-iframe');
      const overlay = document.querySelector('#showreel-overlay');
      
      // Check if Vimeo SDK is available
      if (typeof Vimeo !== 'undefined' && iframe) {
        const player = new Vimeo.Player(iframe);
        
        player.on('play', () => {
          if (overlay) overlay.style.opacity = '0';
        });
        
        // Handle the case where it autoplays immediately
        player.getPaused().then((paused) => {
          if (!paused && overlay) overlay.style.opacity = '0';
        });
      }
    });
  </script>

  <!-- Portfolio Grid Section -->
  <section id="portfolio" class="px-6 pb-24 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-10 border-b border-white/5 pb-6 gap-6">
      <div>
        <h2 class="text-2xl font-bold text-primary mb-2">Portfolio</h2>
        <p class="text-sm text-secondary max-w-xl">
          A collection of projects spanning technical code-driven systems to high-end visual campaigns.
        </p>
      </div>
      
      <div class="flex flex-wrap gap-2" id="filter-controls">
        <button data-filter="all" class="filter-btn active font-mono text-xs px-4 py-2 rounded-full border border-white/10 hover:border-accent/40 transition-all">All</button>
        <button data-filter="motion-design" class="filter-btn font-mono text-xs px-4 py-2 rounded-full border border-white/10 hover:border-accent/40 transition-all">Motion Design</button>
        <button data-filter="live-av" class="filter-btn font-mono text-xs px-4 py-2 rounded-full border border-white/10 hover:border-accent/40 transition-all">Live AV</button>
        <button data-filter="generative-art" class="filter-btn font-mono text-xs px-4 py-2 rounded-full border border-white/10 hover:border-accent/40 transition-all">Generative Art</button>
      </div>
    </div>

    {portfolioEntries.length > 0 ?
      (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
        {portfolioEntries.map((entry) => {
          // 1. Clean the slug here too so the link exactly matches our new dynamic route
          const cleanSlug = entry.id.replace(/\/index$/, '');
          
          return (
            <div class="project-item" data-category={entry.data.category}>
              <ProjectCard
                title={entry.data.title}
                slug={cleanSlug}
                coverImage={entry.data.coverImage}
                techStack={entry.data.techStack ?? []}
              />
            </div>
          );
        })}
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <p class="font-mono text-sm text-secondary/50 mb-2">// no projects yet</p>
        <p class="text-secondary text-sm">Add your first project via the Keystatic CMS at <a href="/keystatic" class="text-accent hover:underline">/keystatic</a></p>
      </div>
    )}
  </section>

  <!-- CTA Banner -->
  <section id="contact" class="px-6 pb-24 max-w-7xl mx-auto">
    <div class="relative bg-surface rounded-2xl border border-white/5 p-12 md:p-16 overflow-hidden text-center">
      <div class="absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-transparent pointer-events-none"></div>
      <p class="font-mono text-accent text-xs tracking-widest uppercase mb-4">Let's Connect</p>
      <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">Have a project in mind?</h2>
      <p class="text-secondary text-base max-w-md mx-auto mb-8">
        I'm open to creative collaborations, freelance work, and full-time opportunities in interactive media.
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="mailto:email@steffanochavez.com" class="inline-flex items-center justify-center gap-2 border border-accent/30 text-accent hover:bg-accent/10 transition-colors duration-200 font-mono text-sm px-6 py-3 rounded-lg w-full sm:w-auto">
          email@steffanochavez.com
        </a>
        <a href="https://calendar.google.com/calendar/appointments/schedules/AcZssZ1fKoVJdxSBqvweqzPqrv-XASxMwjvqC9iEXdRecHW3Uf8t1RcWntWWGfK1oSqCDIqEPR6KK0Rl?gv=true" class="inline-flex items-center justify-center gap-2 border border-accent/30 text-accent hover:bg-accent/10 transition-colors duration-200 font-mono text-sm px-6 py-3 rounded-lg w-full sm:w-auto">
          Schedule a Free Call
        </a>
        <a href="https://www.instagram.com/sscxyz.ig" class="inline-flex items-center justify-center gap-2 border border-accent/30 text-accent hover:bg-accent/10 transition-colors duration-200 font-mono text-sm px-6 py-3 rounded-lg w-full sm:w-auto">
          follow me @sscxyz.ig
        </a>
      </div>

    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="px-6 pb-24 max-w-7xl mx-auto">
    <div class="flex items-baseline justify-between mb-10 border-b border-white/5 pb-6">
      <h2 class="text-2xl font-bold text-primary">Experience</h2>
      <span class="font-mono text-xs text-secondary/60 tracking-widest uppercase">{experienceEntries.length} role{experienceEntries.length !== 1 ? 's' : ''}</span>
    </div>

    <div class="grid grid-cols-1 gap-6">
      {experienceEntries.length > 0 ? (
        experienceEntries.reverse().map((entry) => (
          <ExperienceCard
            role={entry.data.role}
            company={entry.data.company}
            dateRange={entry.data.dateRange}
            techStack={entry.data.techStack ?? []}
            achievements={entry.data.achievements}
          />
        ))
      ) : (
        <p class="text-secondary text-sm font-mono">// no experience entries yet</p>
      )}
    </div>
  </section>

</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state
      filterButtons.forEach(b => b.classList.remove('active', 'border-accent', 'text-accent'));
      btn.classList.add('active', 'border-accent', 'text-accent');

      const filter = btn.getAttribute('data-filter');

      projectItems.forEach(item => {
        if (filter === 'all' || item.getAttribute('data-category') === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Set initial active state for 'all'
  document.querySelector('[data-filter="all"]')?.classList.add('border-accent', 'text-accent');
</script>

<style>
  .filter-btn.active {
    background: rgba(189, 8, 205, 0.05);
  }
</style>
