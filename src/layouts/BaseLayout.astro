---
import '../styles/global.css';
import Chatbot from '../components/Chatbot';
import GenerativeBackground from '../components/GenerativeBackground';

interface Props {
  title?: string;
  description?: string;
}

const { title = "TouchDesigner Portfolio", description = "Creative Technologist specializing in TouchDesigner and WebGL" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title ? `${title} - creative technologist` : "sscxyz"}</title>
  </head>
  <body class="bg-base text-primary font-sans antialiased min-h-screen flex flex-col selection:bg-accent/20 selection:text-accent">
    <header class="sticky top-0 z-50 py-4 px-4 sm:px-8 flex justify-between items-center border-b border-white/5 backdrop-blur-md bg-base/80">
      <div class="text-base font-semibold tracking-tight shrink-0">
        <a href="/" class="text-primary hover:text-accent transition-colors duration-200">
          <span class="font-mono text-accent">sscxyz</span>.website
        </a>
      </div>
      <nav aria-label="Main navigation">
        <ul class="flex items-center gap-3 sm:gap-8 text-[11px] sm:text-sm font-medium text-secondary">
          <li><a href="#portfolio" class="hover:text-primary transition-colors duration-200">Portfolio</a></li>
          <li><a href="#experience" class="hover:text-primary transition-colors duration-200">Experience</a></li>
          <li><a href="#contact" class="hover:text-primary transition-colors duration-200">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main class="flex-grow w-full">
      <slot />
    </main>

    <footer class="py-8 text-center font-mono text-xs text-secondary/50 border-t border-white/5 mt-12">
      <p>&copy; {new Date().getFullYear()} sscxyz</p>
    </footer>

    <Chatbot client:load />
    <GenerativeBackground client:load />

  </body>
</html>
